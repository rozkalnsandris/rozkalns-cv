#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
PATH='/home/andris/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

[[ ${EUID:-$(id -u)} -ne 0 ]] || fail 'pull-deploy preflight must run as an unprivileged user'
[[ "$(id -un)" == 'andris' ]] || fail 'pull-deploy preflight must run as andris'

REPO='rozkalnsandris/rozkalns-cv'
PRIMARY='/home/andris/rozkalns-cv'
SOURCE='/home/andris/rozkalns-cv-worktrees/release-control'
STATE_FILE='/var/lib/rozkalns-cv-deploy/current-sha'
LOCK_ROOT='/home/andris/.local/state/rozkalns-cv-pull-deploy'
LOCK_FILE="$LOCK_ROOT/preflight.lock"
HELPER='/usr/local/sbin/rozkalns-cv-deploy-main'
HELPER_SOURCE='runner/release/rozkalns-cv-deploy-main'
CLASSIFIER='/usr/local/libexec/rozkalns-cv/classify-deploy-impact'
TOKEN_BROKER='/usr/local/sbin/rozkalns-github-app-read-token'

for command_name in flock gh git id install python3 stat sudo; do
    command -v "$command_name" >/dev/null 2>&1 \
        || fail "required command is missing: $command_name"
done

[[ -d "$PRIMARY" && ! -L "$PRIMARY" ]] || fail 'primary CV checkout is missing or unsafe'
[[ -d "$SOURCE" && ! -L "$SOURCE" ]] || fail 'release-control worktree is missing or unsafe'
[[ -f "$STATE_FILE" && ! -L "$STATE_FILE" ]] || fail 'production state file is missing or unsafe'
[[ -x "$HELPER" && ! -L "$HELPER" ]] || fail 'installed deploy helper is missing or unsafe'
[[ "$(stat -c '%U:%G:%a' "$HELPER")" == 'root:root:755' ]] \
    || fail 'installed deploy helper ownership/mode is unexpected'
[[ -x "$CLASSIFIER" && ! -L "$CLASSIFIER" ]] \
    || fail 'deploy-impact classifier is missing or unsafe'
[[ "$(stat -c '%U:%G:%a' "$CLASSIFIER")" == 'root:root:755' ]] \
    || fail 'deploy-impact classifier ownership/mode is unexpected'
[[ -x "$TOKEN_BROKER" && ! -L "$TOKEN_BROKER" ]] \
    || fail 'GitHub App token broker is missing or unsafe'
[[ "$(stat -c '%U:%G:%a' "$TOKEN_BROKER")" == 'root:root:755' ]] \
    || fail 'GitHub App token broker ownership/mode is unexpected'

# Never inherit a persistent user/PAT token. The only authenticated GitHub API
# path is a short-lived, repository-scoped token minted by the root-owned App
# broker from the protected private key.
unset GH_TOKEN GITHUB_TOKEN
GH_TOKEN="$(sudo -n "$TOKEN_BROKER" --repository "$REPO")" \
    || fail 'GitHub App read token is unavailable'
[[ ${#GH_TOKEN} -ge 20 && "$GH_TOKEN" != *[[:space:]]* ]] \
    || fail 'GitHub App read token is malformed'
export GH_TOKEN

install -d -m 0700 "$LOCK_ROOT"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    printf 'PULL_DEPLOY_PREFLIGHT_RESULT=NO_OP_BUSY\n'
    exit 0
fi

git -C "$SOURCE" fetch --prune origin main
[[ -z "$(git -C "$SOURCE" branch --show-current)" ]] \
    || fail 'release-control worktree must remain detached'
[[ -z "$(git -C "$SOURCE" status --porcelain=v1 --untracked-files=all)" ]] \
    || fail 'release-control worktree is not clean'
[[ "$(git -C "$PRIMARY" branch --show-current)" == 'main' ]] \
    || fail 'production checkout must remain on main'

TARGET_SHA="$(git -C "$SOURCE" rev-parse refs/remotes/origin/main)"
PRODUCTION_SHA="$(tr -d '[:space:]' < "$STATE_FILE")"
[[ "$TARGET_SHA" =~ ^[0-9a-f]{40}$ ]] || fail 'origin/main SHA is invalid'
[[ "$PRODUCTION_SHA" =~ ^[0-9a-f]{40}$ ]] || fail 'production state SHA is invalid'

git -C "$SOURCE" cat-file -e "${TARGET_SHA}^{commit}" \
    || fail 'target SHA is not locally available'
git -C "$SOURCE" cat-file -e "${PRODUCTION_SHA}^{commit}" \
    || fail 'production SHA is not locally available'

if [[ "$TARGET_SHA" == "$PRODUCTION_SHA" ]]; then
    printf 'PULL_DEPLOY_PREFLIGHT_RESULT=NO_OP_ALREADY_CURRENT\n'
    printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
    printf 'PRODUCTION_SHA=%s\n' "$PRODUCTION_SHA"
    exit 0
fi

git -C "$SOURCE" merge-base --is-ancestor "$PRODUCTION_SHA" "$TARGET_SHA" \
    || fail 'production SHA is not an ancestor of current origin/main'

RUNS_JSON="$(gh api \
    -H 'Accept: application/vnd.github+json' \
    "repos/$REPO/actions/workflows/ci.yml/runs?branch=main&head_sha=$TARGET_SHA&status=completed&per_page=100")"
CI_RUN_ID="$(python3 -c '
import json, sys
sha = sys.argv[1]
data = json.load(sys.stdin)
runs = [
    row for row in data.get("workflow_runs", [])
    if row.get("event") == "push"
    and row.get("head_branch") == "main"
    and row.get("head_sha") == sha
    and row.get("status") == "completed"
    and row.get("conclusion") == "success"
]
print(max((int(row["id"]) for row in runs), default=""))
' "$TARGET_SHA" <<<"$RUNS_JSON")"

if [[ -z "$CI_RUN_ID" ]]; then
    printf 'PULL_DEPLOY_PREFLIGHT_RESULT=WAIT_CI\n'
    printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
    printf 'PRODUCTION_SHA=%s\n' "$PRODUCTION_SHA"
    exit 0
fi

JOBS_JSON="$(gh api \
    -H 'Accept: application/vnd.github+json' \
    "repos/$REPO/actions/runs/$CI_RUN_ID/jobs?filter=latest&per_page=100")"
python3 -c '
import json, sys
jobs = json.load(sys.stdin).get("jobs", [])
validate = [row for row in jobs if row.get("name") == "validate"]
if len(validate) != 1:
    raise SystemExit(f"expected exactly one validate job, observed={len(validate)}")
job = validate[0]
if job.get("status") != "completed" or job.get("conclusion") != "success":
    raise SystemExit("validate job is not completed/success")
' <<<"$JOBS_JSON" || fail 'exact-SHA CI validate job is not trustworthy'

IMPACT_JSON="$(
    "$CLASSIFIER" \
        --repo "$SOURCE" \
        --base "$PRODUCTION_SHA" \
        --target "$TARGET_SHA" \
        --json
)" || fail 'deploy-impact classification failed'
mapfile -t impact < <(
    python3 -c '
import json, sys
payload = json.load(sys.stdin)
classification = payload.get("classification")
control = payload.get("control_plane_changed")
if classification not in {
    "NO_DEPLOY",
    "AUTO_DEPLOY_SAFE",
    "MANUAL_ROLLOUT_REQUIRED",
    "DB_HOST_APPLY_REQUIRED",
}:
    raise SystemExit("invalid deploy-impact classification")
if not isinstance(control, bool):
    raise SystemExit("invalid control-plane flag")
print(classification)
print("true" if control else "false")
' <<<"$IMPACT_JSON"
)
[[ ${#impact[@]} -eq 2 ]] || fail 'invalid deploy-impact output'
DEPLOY_IMPACT="${impact[0]}"
CONTROL_PLANE_CHANGED="${impact[1]}"

printf 'DEPLOY_IMPACT=%s\n' "$DEPLOY_IMPACT"
printf 'CONTROL_PLANE_CHANGED=%s\n' "$CONTROL_PLANE_CHANGED"

case "$DEPLOY_IMPACT" in
    DB_HOST_APPLY_REQUIRED|MANUAL_ROLLOUT_REQUIRED|NO_DEPLOY)
        printf 'PULL_DEPLOY_PREFLIGHT_RESULT=%s\n' "$DEPLOY_IMPACT"
        printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
        printf 'PRODUCTION_SHA=%s\n' "$PRODUCTION_SHA"
        printf 'CI_RUN_ID=%s\n' "$CI_RUN_ID"
        printf 'PRODUCTION_MUTATION_AUTHORIZED=false\n'
        unset GH_TOKEN
        exit 0
        ;;
    AUTO_DEPLOY_SAFE)
        ;;
    *)
        fail "unsupported deploy impact: $DEPLOY_IMPACT"
        ;;
esac

# Only an auto-deploy-safe target needs the installed production helper to match
# the target source before the later controller stage may become deploy-ready.
# Manual/DB/no-deploy outcomes above remain read-only and never require helper
# activation, avoiding accidental activation of the still-live legacy runner.
EXPECTED_HELPER_BLOB="$(gh api \
    -H 'Accept: application/vnd.github+json' \
    "repos/$REPO/contents/$HELPER_SOURCE?ref=$TARGET_SHA" \
    --jq '.sha')"
[[ "$EXPECTED_HELPER_BLOB" =~ ^[0-9a-f]{40}$ ]] \
    || fail 'target deploy-helper blob SHA is invalid'
ACTUAL_HELPER_BLOB="$(git hash-object "$HELPER")"
[[ "$ACTUAL_HELPER_BLOB" =~ ^[0-9a-f]{40}$ ]] \
    || fail 'installed deploy-helper blob SHA is invalid'

if [[ "$ACTUAL_HELPER_BLOB" != "$EXPECTED_HELPER_BLOB" ]]; then
    printf 'PULL_DEPLOY_PREFLIGHT_RESULT=WAIT_HELPER_ACTIVATION\n'
    printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
    printf 'PRODUCTION_SHA=%s\n' "$PRODUCTION_SHA"
    printf 'CI_RUN_ID=%s\n' "$CI_RUN_ID"
    printf 'DEPLOY_IMPACT=%s\n' "$DEPLOY_IMPACT"
    printf 'PRODUCTION_MUTATION_AUTHORIZED=false\n'
    exit 0
fi

# Deliberately no production deploy call here. The only sudo capability used by
# this stage is the exact read-token broker above; legacy deployment remains
# untouched until a later reviewed canary stage.
printf 'PULL_DEPLOY_PREFLIGHT_RESULT=READY\n'
printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
printf 'PRODUCTION_SHA=%s\n' "$PRODUCTION_SHA"
printf 'CI_RUN_ID=%s\n' "$CI_RUN_ID"
printf 'DEPLOY_IMPACT=%s\n' "$DEPLOY_IMPACT"
printf 'HELPER_BLOB_SHA=%s\n' "$ACTUAL_HELPER_BLOB"
printf 'PRODUCTION_MUTATION_AUTHORIZED=false\n'
unset GH_TOKEN
