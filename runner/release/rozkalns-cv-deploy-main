#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

TARGET_SHA="${1:-}"
EVIDENCE_DIR="${2:-}"

OWNER='andris'
PRIMARY='/home/andris/rozkalns-cv'
RUNTIME='/home/andris/docker/cv'
BACKUP_ROOT='/home/andris/.local-backups/rozkalns-cv/deploy'
STATE_DIR='/var/lib/rozkalns-cv-deploy'
STATE_FILE="$STATE_DIR/current-sha"
LOCK_FILE='/run/lock/rozkalns-cv-deploy.lock'
COMPOSE_ENV_FILE="$RUNTIME/cloudflared.env"
EVIDENCE_ROOT='/home/github-cv-runner/actions-runner/_work/_temp'
LOCAL_URL='http://192.168.0.180:8088/'
PUBLIC_URL='https://rozkalns.net/'
NETWORK_NAME='cv_default'
NETWORK_SUBNET='172.19.0.0/16'
NETWORK_GATEWAY='172.19.0.1'
CVBOT_UID=10001
CVBOT_GID=10001
CVBOT_IMAGE_IDENTITY_REQUIRED=false
CLOUDFLARED_RESTARTED=false
BACKUP_RETENTION_COUNT=5
BACKUP_RETENTION_DAYS=14
MIN_FREE_BYTES=1073741824
MIN_FREE_INODES=10000
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
WORK=''
STAGE=''
CANDIDATE=''
BACKUP=''
OLD_SHA=''
DEPLOYED=false
MUTATION_STARTED=false
TRANSACTION_COMMITTED=false
ROLLBACK_ATTEMPTED=false
SUMMARY_WRITTEN=false
EVIDENCE_READY=false
EVIDENCE_UID=''
EVIDENCE_GID=''

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

owner_git() {
    runuser -u "$OWNER" -- sh -c 'umask 022; exec git "$@"' sh "$@"
}

compose_runtime() {
    (
        cd "$RUNTIME"
        docker compose --env-file "$COMPOSE_ENV_FILE" "$@"
    )
}

compose_at() {
    local root="$1"
    shift
    (
        cd "$root"
        docker compose --env-file "$COMPOSE_ENV_FILE" "$@"
    )
}

validate_rendered_network() {
    local root="$1"
    local rendered
    rendered="$(compose_at "$root" config)" || return 1
    grep -Fq "name: $NETWORK_NAME" <<<"$rendered" || return 1
    grep -Fq "subnet: $NETWORK_SUBNET" <<<"$rendered" || return 1
    grep -Fq "gateway: $NETWORK_GATEWAY" <<<"$rendered" || return 1
}

validate_existing_network() {
    local subnet gateway
    if ! docker network inspect "$NETWORK_NAME" >/dev/null 2>&1; then
        return 0
    fi
    subnet="$(docker network inspect "$NETWORK_NAME" \
        --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}')" || return 1
    gateway="$(docker network inspect "$NETWORK_NAME" \
        --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}')" || return 1
    [[ "$subnet" == "$NETWORK_SUBNET" ]] || return 1
    [[ "$gateway" == "$NETWORK_GATEWAY" ]] || return 1
}

managed_rsync() {
    local source="$1"
    local destination="$2"
    rsync -a --delete \
        --exclude='.git/' \
        --exclude='.env' \
        --exclude='*.env' \
        --exclude='cloudflared.env' \
        --exclude='stats.json' \
        --exclude='bot/data/' \
        "$source/" "$destination/"
}

validate_managed_tree() {
    local root="$1"
    [[ -d "$root" && ! -L "$root" ]] || return 1
    [[ -d "$root/html" && ! -L "$root/html" ]] || return 1
    [[ -f "$root/html/index.html" && ! -L "$root/html/index.html" ]] \
        || return 1
    [[ -f "$root/nginx.conf" && ! -L "$root/nginx.conf" ]] || return 1
    if find "$root" -type l -print -quit | grep -q .; then
        return 1
    fi
}

normalize_managed_permissions() {
    local root="$1"
    validate_managed_tree "$root" || return 1
    find "$root/html" -type d -exec chmod 0755 {} + || return 1
    find "$root/html" -type f -exec chmod 0644 {} + || return 1
    chmod 0644 "$root/nginx.conf" || return 1
}

capacity_ok() {
    local available_bytes="$1"
    local available_inodes="$2"
    local required_bytes="$3"
    local required_inodes="$4"
    (( available_bytes >= required_bytes && available_inodes >= required_inodes ))
}

require_capacity() {
    local path="$1"
    local required_bytes="$2"
    local required_inodes="$3"
    local available_bytes available_inodes

    available_bytes="$(df -PB1 "$path" | awk 'NR == 2 {print $4}')"
    available_inodes="$(df -Pi "$path" | awk 'NR == 2 {print $4}')"
    [[ "$available_bytes" =~ ^[0-9]+$ ]] || return 1
    [[ "$available_inodes" =~ ^[0-9]+$ ]] || return 1
    capacity_ok \
        "$available_bytes" "$available_inodes" \
        "$required_bytes" "$required_inodes"
}

managed_size_bytes() {
    local path="$1"
    local size
    size="$(du -sB1 "$path" | awk 'NR == 1 {print $1}')"
    [[ "$size" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "$size"
}

prepare_candidate() {
    install -d -m 0700 "$CANDIDATE" || return 1
    managed_rsync "$STAGE" "$CANDIDATE" || return 1
    normalize_managed_permissions "$CANDIDATE" || return 1
    install -d -m 0700 "$CANDIDATE/bot" || return 1
    : >"$CANDIDATE/bot/.env" || return 1
    chmod 0600 "$CANDIDATE/bot/.env" || return 1
    if ! validate_rendered_network "$CANDIDATE"; then
        rm -f -- "$CANDIDATE/bot/.env"
        return 1
    fi
    rm -f -- "$CANDIDATE/bot/.env" || return 1
}

create_backup() {
    install -d -m 0700 "$BACKUP/runtime" || return 1
    managed_rsync "$RUNTIME" "$BACKUP/runtime" || return 1
    printf '%s\n' "${OLD_SHA:-unknown}" >"$BACKUP/previous-sha" || return 1
    chmod 0600 "$BACKUP/previous-sha" || return 1
}

prune_backups() {
    local row path
    local -a backups=()

    [[ "$BACKUP_RETENTION_COUNT" =~ ^[1-9][0-9]*$ ]] || return 1
    [[ "$BACKUP_RETENTION_DAYS" =~ ^[0-9]+$ ]] || return 1
    [[ -d "$BACKUP_ROOT" && ! -L "$BACKUP_ROOT" ]] || return 1

    while IFS= read -r -d '' path; do
        rm -rf -- "$path" || return 1
    done < <(
        find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d \
            -mtime "+$BACKUP_RETENTION_DAYS" -print0
    )

    while IFS= read -r row; do
        backups+=("${row#* }")
    done < <(
        find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d \
            -printf '%T@ %p\n' | sort -rn
    )

    if (( ${#backups[@]} > BACKUP_RETENTION_COUNT )); then
        for path in "${backups[@]:BACKUP_RETENTION_COUNT}"; do
            rm -rf -- "$path" || return 1
        done
    fi
}

write_state_atomically() {
    local tmp
    tmp="$(mktemp "$STATE_DIR/.current-sha.XXXXXXXX")" || return 1
    if ! printf '%s\n' "$TARGET_SHA" >"$tmp" \
       || ! chmod 0644 "$tmp" \
       || ! sync -f "$tmp" \
       || ! mv -f -- "$tmp" "$STATE_FILE" \
       || ! sync -f "$STATE_DIR"; then
        rm -f -- "$tmp"
        return 1
    fi
}

write_runtime_manifest() {
    local output="$1"
    (
        cd "$RUNTIME"
        find . -type f \
            ! -path './.git/*' \
            ! -name '.env' \
            ! -name '*.env' \
            ! -name 'cloudflared.env' \
            ! -path './bot/data/*' \
            ! -path './html/stats.json' \
            -print0 \
            | sort -z \
            | xargs -0r sha256sum
    ) >"$output"
}

write_summary() {
    local result="$1"
    local rollback_performed="${2:-false}"
    local final_state='unknown'
    if [[ -s "$STATE_FILE" ]]; then
        final_state="$(tr -d '[:space:]' <"$STATE_FILE")"
    fi
    {
        printf 'DEPLOY_RESULT=%s\n' "$result"
        printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
        printf 'OLD_SHA=%s\n' "${OLD_SHA:-unknown}"
        printf 'FINAL_STATE_SHA=%s\n' "$final_state"
        printf 'PRODUCTION_CHANGED=%s\n' "$DEPLOYED"
        printf 'MUTATION_STARTED=%s\n' "$MUTATION_STARTED"
        printf 'TRANSACTION_COMMITTED=%s\n' "$TRANSACTION_COMMITTED"
        printf 'CLOUDFLARED_RESTARTED=%s\n' "$CLOUDFLARED_RESTARTED"
        printf 'DATABASE_MIGRATIONS_EXECUTED=false\n'
        printf 'ROLLBACK_PERFORMED=%s\n' "$rollback_performed"
        printf 'UTC=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } | tee "$EVIDENCE_DIR/summary.env"
    SUMMARY_WRITTEN=true
}

http_ok() {
    local url="$1"
    local attempts="${2:-8}"
    local delay="${3:-5}"
    local attempt
    for ((attempt = 1; attempt <= attempts; attempt++)); do
        if curl --fail --silent --show-error --max-time 20 "$url" >/dev/null; then
            return 0
        fi
        if (( attempt < attempts )); then
            sleep "$delay"
        fi
    done
    return 1
}

wait_running() {
    local name="$1"
    local attempts="${2:-30}"
    local delay="${3:-2}"
    local attempt state
    for ((attempt = 1; attempt <= attempts; attempt++)); do
        state="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || true)"
        if [[ "$state" == running ]]; then
            return 0
        fi
        if [[ "$state" == exited || "$state" == dead ]]; then
            return 1
        fi
        sleep "$delay"
    done
    return 1
}

wait_healthy() {
    local name="$1"
    local attempts="${2:-60}"
    local delay="${3:-2}"
    local attempt state health
    for ((attempt = 1; attempt <= attempts; attempt++)); do
        state="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || true)"
        health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$name" 2>/dev/null || true)"
        printf 'WAIT_HEALTH name=%s attempt=%s state=%s health=%s\n' \
            "$name" "$attempt" "${state:-missing}" "${health:-missing}"
        if [[ "$state" == running && "$health" == healthy ]]; then
            return 0
        fi
        if [[ "$state" == exited || "$state" == dead || "$health" == unhealthy ]]; then
            return 1
        fi
        sleep "$delay"
    done
    return 1
}

capture_runtime_diagnostics() {
    local label="$1"
    local output="$EVIDENCE_DIR/${label}.log"
    {
        printf 'LABEL=%s\n' "$label"
        printf 'UTC=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf '\n===== COMPOSE PS =====\n'
        compose_runtime ps || true
        printf '\n===== CONTAINER SUMMARY =====\n'
        docker inspect cv cvbot cv-cloudflared \
            --format '{{.Name}}|image={{.Config.Image}}|status={{.State.Status}}|health={{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|started={{.State.StartedAt}}|restarts={{.RestartCount}}' \
            || true
        printf '\n===== CVBOT SECURITY =====\n'
        docker inspect cvbot \
            --format 'user={{.Config.User}}|readonly={{.HostConfig.ReadonlyRootfs}}|cap_add={{json .HostConfig.CapAdd}}|cap_drop={{json .HostConfig.CapDrop}}|security_opt={{json .HostConfig.SecurityOpt}}|pids={{.HostConfig.PidsLimit}}|privileged={{.HostConfig.Privileged}}' \
            || true
        docker inspect cvbot \
            --format '{{range .Mounts}}{{if eq .Destination "/app/data"}}data_mount={{.Destination}}|rw={{.RW}}|type={{.Type}}{{println}}{{end}}{{end}}' \
            || true
        printf '\n===== CVBOT HEALTH HISTORY =====\n'
        docker inspect cvbot \
            --format '{{if .State.Health}}{{range .State.Health.Log}}{{.Start}}|exit={{.ExitCode}}|{{printf "%q" .Output}}{{println}}{{end}}{{else}}no-healthcheck{{end}}' \
            || true
        printf '\n===== CVBOT LOGS =====\n'
        docker logs --tail 240 --timestamps cvbot 2>&1 || true
        printf '\n===== LOCAL HTTP =====\n'
        if curl --fail --silent --show-error --max-time 20 "$LOCAL_URL" >/dev/null; then
            printf 'LOCAL_URL=PASS\n'
        else
            printf 'LOCAL_URL=FAIL\n'
        fi
        printf '\n===== PUBLIC HTTP =====\n'
        if curl --fail --silent --show-error --max-time 20 "$PUBLIC_URL" >/dev/null; then
            printf 'PUBLIC_URL=PASS\n'
        else
            printf 'PUBLIC_URL=FAIL\n'
        fi
    } >"$output" 2>&1
}

prepare_cvbot_data() {
    local data_dir="$RUNTIME/bot/data"
    [[ -d "$RUNTIME/bot" && ! -L "$RUNTIME/bot" ]] || return 1
    if [[ -e "$data_dir" ]]; then
        [[ -d "$data_dir" && ! -L "$data_dir" ]] || return 1
    else
        install -d -o "$CVBOT_UID" -g "$CVBOT_GID" -m 0700 "$data_dir" || return 1
    fi
    if find "$data_dir" -type l -print -quit | grep -q .; then
        return 1
    fi
    chown -R -- "$CVBOT_UID:$CVBOT_GID" "$data_dir" || return 1
    find "$data_dir" -type d -exec chmod 0700 {} + || return 1
    find "$data_dir" -type f -exec chmod 0600 {} + || return 1
}

prepare_cvbot_build_identity() {
    CVBOT_IMAGE_IDENTITY_REQUIRED=false
    if ! grep -Fq 'net.rozkalns.cv.build-input-sha256' "$RUNTIME/bot/Dockerfile"; then
        printf 'CVBOT_IMAGE_IDENTITY_MODE=legacy\n'
        unset CVBOT_VCS_REF CVBOT_BUILD_INPUT_SHA256 || true
        return 0
    fi
    [[ -f "$RUNTIME/scripts/build-input-id.py" && ! -L "$RUNTIME/scripts/build-input-id.py" ]] || return 1
    CVBOT_VCS_REF="$TARGET_SHA"
    if [[ "$ROLLBACK_ATTEMPTED" == true && "$OLD_SHA" =~ ^[0-9a-f]{40}$ ]]; then
        CVBOT_VCS_REF="$OLD_SHA"
    fi
    CVBOT_BUILD_INPUT_SHA256="$(python3 "$RUNTIME/scripts/build-input-id.py" "$RUNTIME")" || return 1
    [[ "$CVBOT_VCS_REF" =~ ^[0-9a-f]{40}$ ]] || return 1
    [[ "$CVBOT_BUILD_INPUT_SHA256" =~ ^[0-9a-f]{64}$ ]] || return 1
    export CVBOT_VCS_REF CVBOT_BUILD_INPUT_SHA256
    CVBOT_IMAGE_IDENTITY_REQUIRED=true
    printf 'CVBOT_VCS_REF=%s\n' "$CVBOT_VCS_REF"
    printf 'CVBOT_BUILD_INPUT_SHA256=%s\n' "$CVBOT_BUILD_INPUT_SHA256"
}

verify_cvbot_image_identity() {
    local image_ref revision build_input
    [[ "$CVBOT_IMAGE_IDENTITY_REQUIRED" == true ]] || return 0
    image_ref="rozkalns-cv-cvbot:${CVBOT_VCS_REF}"
    docker image inspect "$image_ref" >/dev/null || return 1
    revision="$(docker image inspect "$image_ref" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')" || return 1
    build_input="$(docker image inspect "$image_ref" --format '{{index .Config.Labels "net.rozkalns.cv.build-input-sha256"}}')" || return 1
    [[ "$revision" == "$CVBOT_VCS_REF" ]] || return 1
    [[ "$build_input" == "$CVBOT_BUILD_INPUT_SHA256" ]] || return 1
}

verify_cvbot_runtime_security() {
    local security
    security="$(docker inspect cvbot --format '{"user":{{json .Config.User}},"readonly":{{json .HostConfig.ReadonlyRootfs}},"cap_add":{{json .HostConfig.CapAdd}},"cap_drop":{{json .HostConfig.CapDrop}},"security_opt":{{json .HostConfig.SecurityOpt}},"pids":{{json .HostConfig.PidsLimit}},"privileged":{{json .HostConfig.Privileged}},"mounts":{{json .Mounts}}}')" || return 1
    python3 - "$CVBOT_UID" "$CVBOT_GID" "$security" <<'PY'
import json
import sys

uid, gid, raw = sys.argv[1:4]
data = json.loads(raw)
expected_user = f"{uid}:{gid}"


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(message)


require(data.get("user") == expected_user, "cvbot user mismatch")
require(data.get("readonly") is True, "cvbot rootfs is writable")
require(data.get("privileged") is False, "cvbot is privileged")
require((data.get("cap_add") or []) == [], "cvbot has added capabilities")
cap_drop = [str(value).upper() for value in (data.get("cap_drop") or [])]
require(cap_drop == ["ALL"], "cvbot does not drop all capabilities")
security_opt = [str(value).lower() for value in (data.get("security_opt") or [])]
require(
    "no-new-privileges:true" in security_opt,
    "cvbot no-new-privileges is missing",
)
require(data.get("pids") == 128, "cvbot pids limit mismatch")
mounts = data.get("mounts") or []
data_mounts = [row for row in mounts if row.get("Destination") == "/app/data"]
require(len(data_mounts) == 1, "cvbot data mount count mismatch")
require(data_mounts[0].get("RW") is True, "cvbot data mount is not writable")
unexpected_rw = [
    row.get("Destination")
    for row in mounts
    if row.get("RW") is True
    and row.get("Destination") not in {"/app/data", "/tmp"}
]
require(not unexpected_rw, "cvbot has an unexpected writable mount")

print("CVBOT_RUNTIME_SECURITY=PASS")
print(f"CVBOT_RUNTIME_USER={expected_user}")
print("CVBOT_ROOTFS_READ_ONLY=true")
print("CVBOT_CAP_ADD=none")
print("CVBOT_CAP_DROP=ALL")
print("CVBOT_NO_NEW_PRIVILEGES=true")
print("CVBOT_PIDS_LIMIT=128")
print("CVBOT_DATA_RW=true")
PY
}

expected_cloudflared_image() {
    local images count image
    images="$(compose_runtime config --images)" || return 1
    count="$(grep -Ec '^cloudflare/cloudflared:' <<<"$images" || true)"
    [[ "$count" == 1 ]] || return 1
    image="$(grep -E '^cloudflare/cloudflared:' <<<"$images")" || return 1
    [[ "$image" == *@sha256:* ]] || return 1
    printf '%s\n' "$image"
}

reconcile_cloudflared() {
    local expected before after actual
    expected="$(expected_cloudflared_image)" || return 1
    before="$(docker inspect -f '{{.Id}}' cv-cloudflared 2>/dev/null || true)"
    compose_runtime up -d --no-deps cloudflared || return 1
    wait_running cv-cloudflared 30 2 || return 1
    after="$(docker inspect -f '{{.Id}}' cv-cloudflared 2>/dev/null || true)"
    actual="$(docker inspect -f '{{.Config.Image}}' cv-cloudflared 2>/dev/null || true)"
    [[ -n "$after" ]] || return 1
    [[ "$actual" == "$expected" ]] || return 1
    if [[ -z "$before" || "$before" != "$after" ]]; then
        CLOUDFLARED_RESTARTED=true
    fi
    printf 'CLOUDFLARED_IMAGE_IDENTITY=PASS\n'
    printf 'CLOUDFLARED_IMAGE=%s\n' "$actual"
    printf 'CLOUDFLARED_RESTARTED=%s\n' "$CLOUDFLARED_RESTARTED"
}

deploy_runtime() {
    normalize_managed_permissions "$RUNTIME" || return 1
    prepare_cvbot_data || return 1
    prepare_cvbot_build_identity || return 1
    validate_rendered_network "$RUNTIME" || return 1
    validate_existing_network || return 1
    compose_runtime config --quiet || return 1
    compose_runtime build cvbot || return 1
    verify_cvbot_image_identity || return 1
    compose_runtime up -d --no-deps cvbot || return 1
    wait_healthy cvbot 60 2 || return 1
    verify_cvbot_runtime_security || return 1
    compose_runtime up -d --no-deps cv || return 1
    wait_running cv 30 2 || return 1
    http_ok "$LOCAL_URL" 10 3 || return 1
    reconcile_cloudflared || return 1
    http_ok "$PUBLIC_URL" 10 5 || return 1
}

rollback() {
    ROLLBACK_ATTEMPTED=true
    printf 'ROLLBACK_BEGIN=true\n' | tee -a "$EVIDENCE_DIR/deploy.log"
    if ! managed_rsync "$BACKUP/runtime" "$RUNTIME"; then
        capture_runtime_diagnostics 'failed-rollback-sync-runtime'
        printf 'ROLLBACK_END=FAIL\n' | tee -a "$EVIDENCE_DIR/deploy.log"
        write_summary 'FAIL_ROLLBACK_FAIL' true || true
        return 1
    fi
    if deploy_runtime; then
        capture_runtime_diagnostics 'post-rollback-runtime'
        write_runtime_manifest "$EVIDENCE_DIR/rollback-managed.sha256" || true
        printf 'ROLLBACK_END=PASS\n' | tee -a "$EVIDENCE_DIR/deploy.log"
        write_summary 'FAIL_ROLLBACK_PASS' true || true
        return 0
    fi
    capture_runtime_diagnostics 'failed-rollback-runtime'
    printf 'ROLLBACK_END=FAIL\n' | tee -a "$EVIDENCE_DIR/deploy.log"
    write_summary 'FAIL_ROLLBACK_FAIL' true || true
    return 1
}

finalize_evidence() {
    [[ "$EVIDENCE_READY" == true ]] || return 0
    [[ -d "$EVIDENCE_DIR" && ! -L "$EVIDENCE_DIR" ]] || return 0
    chown -R -- "$EVIDENCE_UID:$EVIDENCE_GID" "$EVIDENCE_DIR"
    chmod -R u+rwX,go-rwx "$EVIDENCE_DIR"
}

finish() {
    local rc="$1"
    trap - EXIT
    if (( rc != 0 )) \
       && [[ "$MUTATION_STARTED" == true ]] \
       && [[ "$TRANSACTION_COMMITTED" != true ]] \
       && [[ "$ROLLBACK_ATTEMPTED" != true ]] \
       && [[ -n "$BACKUP" && -d "$BACKUP/runtime" ]]; then
        rollback || true
    fi
    if [[ -n "$STAGE" && -d "$STAGE" ]]; then
        owner_git -C "$PRIMARY" worktree remove --force "$STAGE" >/dev/null 2>&1 || true
    fi
    if [[ -n "$WORK" && -d "$WORK" ]]; then
        rm -rf -- "$WORK"
    fi
    finalize_evidence || true
    exit "$rc"
}
trap 'finish $?' EXIT

if [[ "${ROZKALNS_CV_DEPLOY_LIBRARY_ONLY:-}" == 1 ]]; then
    return 0 2>/dev/null || exit 0
fi

[[ ${EUID:-$(id -u)} -eq 0 ]] || fail 'deployment helper must run as root'
[[ "${SUDO_USER:-}" == github-cv-runner ]] \
    || fail 'deployment helper must be invoked by the dedicated CV runner'
[[ "${SUDO_UID:-}" =~ ^[0-9]+$ && "${SUDO_GID:-}" =~ ^[0-9]+$ ]] \
    || fail 'runner uid/gid are unavailable'
[[ "${SUDO_UID}" -gt 0 && "${SUDO_GID}" -gt 0 ]] \
    || fail 'runner uid/gid must be non-root'
EVIDENCE_UID="$SUDO_UID"
EVIDENCE_GID="$SUDO_GID"

for command_name in \
    awk bash chmod chown curl df docker du find flock grep head install mktemp mv \
    python3 realpath rm rsync runuser sha256sum sort stat sync tee tr xargs
do
    command -v "$command_name" >/dev/null 2>&1 \
        || fail "required command is missing: $command_name"
done

[[ "$TARGET_SHA" =~ ^[0-9a-f]{40}$ ]] || fail 'target SHA is invalid'
[[ -n "$EVIDENCE_DIR" ]] || fail 'evidence directory is required'
[[ -d "$PRIMARY/.git" ]] || fail "primary Git repository is missing: $PRIMARY"
[[ -d "$RUNTIME" && ! -L "$RUNTIME" ]] \
    || fail "runtime directory is missing or a symlink: $RUNTIME"
[[ -s "$COMPOSE_ENV_FILE" && ! -L "$COMPOSE_ENV_FILE" ]] \
    || fail 'host-only cloudflared.env is missing, empty, or a symlink'
[[ -d "$EVIDENCE_DIR" && ! -L "$EVIDENCE_DIR" ]] \
    || fail 'evidence directory must already exist and must not be a symlink'

EVIDENCE_REAL="$(realpath -e -- "$EVIDENCE_DIR")"
case "$EVIDENCE_REAL" in
    "$EVIDENCE_ROOT"/rozkalns-cv-main-deploy-*)
        ;;
    *)
        fail 'evidence directory is outside the dedicated runner temp root'
        ;;
esac
[[ "$(stat -c '%u' "$EVIDENCE_DIR")" == "$EVIDENCE_UID" ]] \
    || fail 'evidence directory is not owned by the invoking runner'
[[ "$(stat -c '%g' "$EVIDENCE_DIR")" == "$EVIDENCE_GID" ]] \
    || fail 'evidence directory group does not match the invoking runner'
EVIDENCE_DIR="$EVIDENCE_REAL"
EVIDENCE_READY=true

install -d -m 0700 "$BACKUP_ROOT"
install -d -m 0755 "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock 9
prune_backups || fail 'backup retention preflight failed'
validate_existing_network \
    || fail 'existing cv_default network conflicts with the pinned subnet'

RUNTIME_BYTES="$(managed_size_bytes "$RUNTIME")" \
    || fail 'could not determine runtime size'
REQUIRED_RUNTIME_BYTES=$((RUNTIME_BYTES * 2 + MIN_FREE_BYTES))
REQUIRED_BACKUP_BYTES=$((RUNTIME_BYTES + MIN_FREE_BYTES))
require_capacity "$RUNTIME" "$REQUIRED_RUNTIME_BYTES" "$MIN_FREE_INODES" \
    || fail 'runtime filesystem lacks required free space or inodes'
require_capacity "$BACKUP_ROOT" "$REQUIRED_BACKUP_BYTES" "$MIN_FREE_INODES" \
    || fail 'backup filesystem lacks required free space or inodes'

owner_git -C "$PRIMARY" fetch --prune origin main
REMOTE_MAIN="$(owner_git -C "$PRIMARY" rev-parse refs/remotes/origin/main)"
owner_git -C "$PRIMARY" cat-file -e "${TARGET_SHA}^{commit}"
owner_git -C "$PRIMARY" merge-base --is-ancestor "$TARGET_SHA" "$REMOTE_MAIN" \
    || fail 'target SHA is not an ancestor of current origin/main'

if [[ -s "$STATE_FILE" ]]; then
    OLD_SHA="$(tr -d '[:space:]' <"$STATE_FILE")"
fi

if [[ "$OLD_SHA" == "$TARGET_SHA" ]]; then
    write_summary 'NO_OP_ALREADY_CURRENT' false
    exit 0
fi

if [[ "$OLD_SHA" =~ ^[0-9a-f]{40}$ ]] \
   && owner_git -C "$PRIMARY" merge-base --is-ancestor "$TARGET_SHA" "$OLD_SHA"; then
    write_summary 'NO_OP_STALE' false
    exit 0
fi

install -d -o "$OWNER" -g "$OWNER" -m 0700 \
    /home/andris/.cache/rozkalns-cv-deploy
WORK="$(runuser -u "$OWNER" -- \
    mktemp -d '/home/andris/.cache/rozkalns-cv-deploy/run.XXXXXXXX')"
STAGE="$WORK/source"
CANDIDATE="$WORK/candidate"
owner_git -C "$PRIMARY" worktree add --detach "$STAGE" "$TARGET_SHA" >/dev/null

runuser -u "$OWNER" -- bash -c \
    'cd "$1" && exec bash "$1/scripts/validate-source.sh" "$1"' \
    bash "$STAGE" \
    >"$EVIDENCE_DIR/source-validation.log" 2>&1 \
    || fail 'source validation failed'
prepare_candidate || fail 'candidate preparation failed'

BACKUP="$BACKUP_ROOT/${STAMP}-${OLD_SHA:-unknown}"
create_backup || fail 'rollback backup creation failed'
capture_runtime_diagnostics 'pre-deploy-runtime'

MUTATION_STARTED=true
DEPLOYED=true
if ! managed_rsync "$CANDIDATE" "$RUNTIME" \
    >"$EVIDENCE_DIR/deploy.log" 2>&1; then
    capture_runtime_diagnostics 'failed-source-sync-runtime'
    fail 'production source synchronization failed'
fi

if ! deploy_runtime >>"$EVIDENCE_DIR/deploy.log" 2>&1; then
    capture_runtime_diagnostics 'failed-deploy-runtime'
    fail 'runtime deployment checks failed'
fi

capture_runtime_diagnostics 'post-deploy-runtime'
write_runtime_manifest "$EVIDENCE_DIR/runtime-managed.sha256" \
    || fail 'runtime manifest generation failed'
write_state_atomically || fail 'atomic deployed-state update failed'
TRANSACTION_COMMITTED=true
prune_backups || printf 'WARNING: post-deploy backup pruning failed\n' \
    | tee -a "$EVIDENCE_DIR/deploy.log" >&2
write_summary 'PASS' false
