verify_public_frontend_contracts() {
    local tmp html local_root_headers root_headers page_headers
    local local_root_status local_root_location expected_local_location
    local root_status root_location expected_location
    local module_path module_headers content_type csp attempt
    tmp="$(mktemp -d)" || return 1
    html="$tmp/en.html"
    local_root_headers="$tmp/local-root.headers"
    root_headers="$tmp/root.headers"
    page_headers="$tmp/en.headers"
    expected_local_location="${LOCAL_URL%/}/en/"
    expected_location="${PUBLIC_URL%/}/en/"

    if ! local_root_status="$(
        curl --silent --show-error --max-time 20 \
            --dump-header "$local_root_headers" \
            --output /dev/null \
            --write-out '%{http_code}' \
            "$LOCAL_URL"
    )"; then
        printf 'LOCAL_ROOT_REDIRECT=FAIL reason=curl\n'
        rm -rf -- "$tmp"
        return 1
    fi
    local_root_location="$(
        awk 'tolower($1) == "location:" { value=$2; sub(/\r$/, "", value); print value; exit }' \
            "$local_root_headers"
    )"
    if [[ "$local_root_status" != 308 ]]; then
        printf 'LOCAL_ROOT_REDIRECT=FAIL reason=status actual=%s expected=308\n' \
            "$local_root_status"
        rm -rf -- "$tmp"
        return 1
    fi
    # nginx forms an absolute redirect from its internal :80 listener even
    # though Docker publishes that listener as loopback :8088 on the host.
    # Keep the local contract loopback-only while tolerating that port elision.
    case "$local_root_location" in
        /en/|"$expected_local_location"|http://127.0.0.1/en/)
            ;;
        *)
            printf 'LOCAL_ROOT_REDIRECT=FAIL reason=location actual=%s expected=%s\n' \
                "${local_root_location:-missing}" "$expected_local_location"
            rm -rf -- "$tmp"
            return 1
            ;;
    esac
    printf 'LOCAL_ROOT_REDIRECT=PASS status=%s location=%s\n' \
        "$local_root_status" "$local_root_location"

    root_status=''
    root_location=''
    for (( attempt = 1; attempt <= PUBLIC_CONTRACT_ATTEMPTS; attempt++ )); do
        : >"$root_headers"
        if root_status="$(
            curl --silent --show-error --max-time 20 \
                --header 'Cache-Control: no-cache' \
                --header 'Pragma: no-cache' \
                --dump-header "$root_headers" \
                --output /dev/null \
                --write-out '%{http_code}' \
                "$PUBLIC_URL"
        )"; then
            root_location="$(
                awk 'tolower($1) == "location:" { value=$2; sub(/\r$/, "", value); print value; exit }' \
                    "$root_headers"
            )"
        else
            root_status='curl-error'
            root_location=''
        fi

        if [[ "$root_status" == 308 && "$root_location" == "$expected_location" ]]; then
            printf 'PUBLIC_ROOT_REDIRECT_ATTEMPT=PASS attempt=%s status=%s location=%s\n' \
                "$attempt" "$root_status" "$root_location"
            break
        fi

        printf 'PUBLIC_ROOT_REDIRECT_ATTEMPT=RETRY attempt=%s status=%s location=%s expected=%s\n' \
            "$attempt" "$root_status" "${root_location:-missing}" "$expected_location"
        if (( attempt < PUBLIC_CONTRACT_ATTEMPTS )); then
            sleep "$PUBLIC_CONTRACT_RETRY_DELAY_SECONDS"
        fi
    done

    if [[ "$root_status" != 308 || "$root_location" != "$expected_location" ]]; then
        printf 'PUBLIC_ROOT_REDIRECT=FAIL status=%s location=%s expected_status=308 expected_location=%s attempts=%s\n' \
            "$root_status" "${root_location:-missing}" "$expected_location" \
            "$PUBLIC_CONTRACT_ATTEMPTS"
        rm -rf -- "$tmp"
        return 1
    fi

    if ! curl --fail --silent --show-error --max-time 20 \
        --header 'Cache-Control: no-cache' \
        --header 'Pragma: no-cache' \
        --dump-header "$page_headers" \
        --output "$html" \
        "$expected_location"; then
        printf 'PUBLIC_SITE=FAIL reason=page-fetch url=%s\n' "$expected_location"
        rm -rf -- "$tmp"
        return 1
    fi

    module_path="$(
        grep -oE '/assets/app\.[0-9a-f]{12}\.mjs\?cfg=[0-9a-f]{12}' "$html" \
            | head -n 1 \
            || true
    )"
    if [[ -z "$module_path" ]]; then
        printf 'PUBLIC_SITE=FAIL reason=module-path-missing\n'
        rm -rf -- "$tmp"
        return 1
    fi

    if ! module_headers="$(
        curl --fail --silent --show-error --head --max-time 20 \
            "${PUBLIC_URL%/}${module_path}"
    )"; then
        printf 'PUBLIC_MODULE_MIME=FAIL reason=module-fetch path=%s\n' "$module_path"
        rm -rf -- "$tmp"
        return 1
    fi

    content_type="$(
        printf '%s\n' "$module_headers" \
            | awk 'tolower($1) == "content-type:" { value=$2; sub(/\r$/, "", value); print value; exit }'
    )"
    case "$content_type" in
        text/javascript|application/javascript)
            ;;
        *)
            printf 'PUBLIC_MODULE_MIME=FAIL actual=%s\n' "${content_type:-missing}"
            rm -rf -- "$tmp"
            return 1
            ;;
    esac

    if ! printf '%s\n' "$module_headers" \
        | grep -Eiq '^Cache-Control:.*immutable'; then
        printf 'PUBLIC_CACHE_IMMUTABLE=FAIL path=%s\n' "$module_path"
        rm -rf -- "$tmp"
        return 1
    fi
    if ! printf '%s\n' "$module_headers" \
        | grep -Eiq '^X-Content-Type-Options:[[:space:]]*nosniff'; then
        printf 'PUBLIC_NOSNIFF=FAIL path=%s\n' "$module_path"
        rm -rf -- "$tmp"
        return 1
    fi

    csp="$(
        awk 'tolower($1) == "content-security-policy:" { sub(/\r$/, ""); sub(/^[^:]+:[[:space:]]*/, ""); print; exit }' \
            "$page_headers"
    )"
    if [[ ! "$csp" =~ nonce-[0-9a-f]{32} ]] \
       || [[ "$csp" != *"script-src-attr 'none'"* ]] \
       || [[ "$csp" != *"https://static.cloudflareinsights.com/beacon.min.js"* ]] \
       || [[ "$csp" == *"unsafe-inline"* ]]; then
        printf 'PUBLIC_CSP_NONCE=FAIL reason=policy-contract\n'
        rm -rf -- "$tmp"
        return 1
    fi

    rm -rf -- "$tmp"
    printf 'PUBLIC_ROOT_REDIRECT=PASS location=%s\n' "$root_location"
    printf 'PUBLIC_SITE=PASS\n'
    printf 'PUBLIC_MODULE_MIME=PASS type=%s\n' "$content_type"
    printf 'PUBLIC_CACHE_IMMUTABLE=PASS\n'
    printf 'PUBLIC_NOSNIFF=PASS\n'
    printf 'PUBLIC_CSP_NONCE=PASS\n'
}

install -d -m 0700 "$BACKUP_ROOT"
install -d -m 0755 "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock 9
prune_backups || fail 'backup retention preflight failed'
validate_existing_network \
    || fail 'existing cv_default network conflicts with the pinned subnet'

RUNTIME_BYTES="$(managed_size_bytes "$RUNTIME")" \
    || fail 'could not determine runtime size'
REQUIRED_RUNTIME_BYTES=$((RUNTIME_BYTES * 2 + MIN_FREE_BYTES))
