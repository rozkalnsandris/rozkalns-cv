    || fail 'runtime filesystem lacks required free space or inodes'
require_capacity "$BACKUP_ROOT" "$REQUIRED_BACKUP_BYTES" "$MIN_FREE_INODES" \
    || fail 'backup filesystem lacks required free space or inodes'
require_capacity \
    "$VALIDATION_TMP_ROOT" "$MIN_VALIDATION_TMP_BYTES" "$MIN_VALIDATION_TMP_INODES" \
    || fail 'validation temp filesystem lacks required free space or inodes'

