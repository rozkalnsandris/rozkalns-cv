#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

DEPLOY_LIBRARY='/usr/local/libexec/rozkalns-cv/rozkalns-cv-deploy-library'
PULL_EVIDENCE_ROOT='/home/andris/.local/state/rozkalns-cv-pull-deploy/evidence'
PULL_CALLER='andris'
VALIDATION_TMP_ROOT='/tmp'
MIN_VALIDATION_TMP_BYTES=268435456
MIN_VALIDATION_TMP_INODES=10000

fail_bootstrap() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

[[ ${EUID:-$(id -u)} -eq 0 ]] || fail_bootstrap 'pull-deploy helper must run as root'
[[ "$#" -eq 2 ]] \
    || fail_bootstrap 'pull-deploy helper requires exactly target SHA and evidence directory'
[[ -f "$DEPLOY_LIBRARY" && ! -L "$DEPLOY_LIBRARY" ]] \
    || fail_bootstrap 'installed deploy library is missing or unsafe'
[[ "$(stat -c '%U:%G:%a' "$DEPLOY_LIBRARY")" == 'root:root:755' ]] \
    || fail_bootstrap 'installed deploy library ownership/mode is unexpected'

ROZKALNS_CV_DEPLOY_LIBRARY_ONLY=1
# shellcheck source=/dev/null
source "$DEPLOY_LIBRARY"
unset ROZKALNS_CV_DEPLOY_LIBRARY_ONLY

for command_name in \
    awk bash chmod chown curl df docker du find flock grep head id install mktemp mv \
    python3 realpath rm rsync runuser sha256sum sort stat sync tee tr wc xargs
do
    command -v "$command_name" >/dev/null 2>&1 \
        || fail "required command is missing: $command_name"
done

runtime_requires_cvbot_client_secret() {
    local root="$1"
    local storage="$root/bot/storage.py"
    [[ -f "$storage" && ! -L "$storage" ]] || return 1
    grep -Fq 'CLIENT_KEY_SECRET_MIN_BYTES = 32' "$storage" \
        && grep -Fq 'def validate_client_key_secret' "$storage"
}

validate_cvbot_runtime_secret_strict() {
    local env_file="$RUNTIME/bot/.env"
    [[ -f "$env_file" && ! -L "$env_file" ]] || return 1
    python3 - "$env_file" <<'PY_SECRET'
from __future__ import annotations

import base64
import binascii
import hmac
from pathlib import Path
import sys

path = Path(sys.argv[1])
values: dict[str, str] = {}
for raw in path.read_text(encoding="utf-8").splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    key, separator, value = line.partition("=")
    key = key.strip()
    if not separator or key not in {"CLIENT_KEY_SECRET", "LLM_API_KEY"}:
        continue
    if key in values:
        raise SystemExit("cvbot secret contract failed: duplicate key")
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        value = value[1:-1]
    values[key] = value

secret = values.get("CLIENT_KEY_SECRET", "")
allowed = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_")
if not secret or not secret.isascii() or any(
    character not in allowed for character in secret
):
    raise SystemExit("cvbot client pseudonymization secret contract failed")
padding = "=" * ((4 - len(secret) % 4) % 4)
try:
    decoded = base64.b64decode(secret + padding, altchars=b"-_", validate=True)
except (binascii.Error, ValueError):
    raise SystemExit(
        "cvbot client pseudonymization secret contract failed"
    ) from None
if len(decoded) < 32:
    raise SystemExit("cvbot client pseudonymization secret contract failed")
provider = values.get("LLM_API_KEY", "")
if provider and hmac.compare_digest(secret, provider):
    raise SystemExit("cvbot client pseudonymization secret must be dedicated")
print("CVBOT_CLIENT_KEY_SECRET=PASS")
PY_SECRET
}

# The sourced deployment library calls validate_cvbot_runtime_secret() from
# deploy_runtime(). Override that function only inside the pull transport so
# rollback evaluates the source tree that was actually restored. Older
# baselines that predate the dedicated pseudonymization key do not inherit a
# newer target-only prerequisite; baselines that require it still get the
# strict, non-disclosing validation.
validate_cvbot_runtime_secret() {
    if runtime_requires_cvbot_client_secret "$RUNTIME"; then
        validate_cvbot_runtime_secret_strict
    else
        printf 'CVBOT_CLIENT_KEY_SECRET=NOT_REQUIRED_BY_BASELINE\n'
    fi
}

validate_candidate_runtime_prerequisites() {
    if runtime_requires_cvbot_client_secret "$CANDIDATE"; then
        validate_cvbot_runtime_secret_strict || return 1
        printf 'TARGET_RUNTIME_PREREQUISITES=PASS\n'
    else
        printf 'TARGET_RUNTIME_PREREQUISITES=NO_SECRET_REQUIRED\n'
    fi
}

[[ "${SUDO_USER:-}" == "$PULL_CALLER" ]] \
    || fail 'pull-deploy helper must be invoked by the dedicated local controller'
[[ "${SUDO_UID:-}" =~ ^[0-9]+$ && "${SUDO_GID:-}" =~ ^[0-9]+$ ]] \
    || fail 'pull-deploy caller uid/gid are unavailable'
[[ "${SUDO_UID}" -gt 0 && "${SUDO_GID}" -gt 0 ]] \
    || fail 'pull-deploy caller uid/gid must be non-root'
[[ "$(id -un "$SUDO_UID" 2>/dev/null)" == "$PULL_CALLER" ]] \
    || fail 'pull-deploy caller identity mismatch'
EVIDENCE_UID="$SUDO_UID"
EVIDENCE_GID="$SUDO_GID"

[[ "$TARGET_SHA" =~ ^[0-9a-f]{40}$ ]] || fail 'target SHA is invalid'
[[ -n "$EVIDENCE_DIR" ]] || fail 'evidence directory is required'
[[ -d "$PRIMARY/.git" ]] || fail "primary Git repository is missing: $PRIMARY"
[[ -d "$RUNTIME" && ! -L "$RUNTIME" ]] \
    || fail "runtime directory is missing or a symlink: $RUNTIME"
[[ -d "$EVIDENCE_DIR" && ! -L "$EVIDENCE_DIR" ]] \
    || fail 'evidence directory must already exist and must not be a symlink'

EVIDENCE_REAL="$(realpath -e -- "$EVIDENCE_DIR")"
case "$EVIDENCE_REAL" in
    "$PULL_EVIDENCE_ROOT"/rozkalns-cv-main-deploy-*)
        ;;
    *)
        fail 'evidence directory is outside the pull-deploy evidence root'
        ;;
esac
[[ "$(stat -c '%u' "$EVIDENCE_DIR")" == "$EVIDENCE_UID" ]] \
    || fail 'evidence directory is not owned by the pull-deploy caller'
[[ "$(stat -c '%g' "$EVIDENCE_DIR")" == "$EVIDENCE_GID" ]] \
    || fail 'evidence directory group does not match the pull-deploy caller'
EVIDENCE_DIR="$EVIDENCE_REAL"
EVIDENCE_READY=true
printf 'DEPLOY_TRANSPORT=pull-controller\n' >"$EVIDENCE_DIR/transport.env"

verify_public_frontend_contracts() {
    local tmp html root_headers module_path module_headers content_type csp
    tmp="$(mktemp -d)" || return 1
    html="$tmp/root.html"
    root_headers="$tmp/root.headers"

    if ! curl --fail --silent --show-error --max-time 20 \
        --dump-header "$root_headers" \
        --output "$html" \
        "$PUBLIC_URL"; then
        rm -rf -- "$tmp"
        return 1
    fi

    module_path="$(
        grep -oE '/assets/app\.[0-9a-f]{12}\.mjs\?cfg=[0-9a-f]{12}' "$html" \
            | head -n 1 \
            || true
    )"
    if [[ -z "$module_path" ]]; then
        rm -rf -- "$tmp"
        return 1
    fi

    if ! module_headers="$(
        curl --fail --silent --show-error --head --max-time 20 \
            "${PUBLIC_URL%/}${module_path}"
    )"; then
        rm -rf -- "$tmp"
        return 1
    fi

    content_type="$(
        printf '%s\n' "$module_headers" \
            | awk 'tolower($1) == "content-type:" { value=$2; sub(/\r$/, "", value); print value; exit }'
    )"
    case "$content_type" in
        text/javascript|application/javascript)
            ;;
        *)
            rm -rf -- "$tmp"
            return 1
            ;;
    esac

    if ! printf '%s\n' "$module_headers" \
        | grep -Eiq '^Cache-Control:.*immutable'; then
        rm -rf -- "$tmp"
        return 1
    fi
    if ! printf '%s\n' "$module_headers" \
        | grep -Eiq '^X-Content-Type-Options:[[:space:]]*nosniff'; then
        rm -rf -- "$tmp"
        return 1
    fi

    csp="$(
        awk 'tolower($1) == "content-security-policy:" { sub(/\r$/, ""); sub(/^[^:]+:[[:space:]]*/, ""); print; exit }' \
            "$root_headers"
    )"
    if [[ ! "$csp" =~ nonce-[0-9a-f]{32} ]] \
       || [[ "$csp" != *"script-src-attr 'none'"* ]] \
       || [[ "$csp" != *"https://static.cloudflareinsights.com/beacon.min.js"* ]] \
       || [[ "$csp" == *"unsafe-inline"* ]]; then
        rm -rf -- "$tmp"
        return 1
    fi

    rm -rf -- "$tmp"
    printf 'PUBLIC_SITE=PASS\n'
    printf 'PUBLIC_MODULE_MIME=PASS type=%s\n' "$content_type"
    printf 'PUBLIC_CACHE_IMMUTABLE=PASS\n'
    printf 'PUBLIC_NOSNIFF=PASS\n'
    printf 'PUBLIC_CSP_NONCE=PASS\n'
}

install -d -m 0700 "$BACKUP_ROOT"
install -d -m 0755 "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock 9
prune_backups || fail 'backup retention preflight failed'
validate_existing_network \
    || fail 'existing cv_default network conflicts with the pinned subnet'

RUNTIME_BYTES="$(managed_size_bytes "$RUNTIME")" \
    || fail 'could not determine runtime size'
REQUIRED_RUNTIME_BYTES=$((RUNTIME_BYTES * 2 + MIN_FREE_BYTES))
REQUIRED_BACKUP_BYTES=$((RUNTIME_BYTES + MIN_FREE_BYTES))
require_capacity "$RUNTIME" "$REQUIRED_RUNTIME_BYTES" "$MIN_FREE_INODES" \
    || fail 'runtime filesystem lacks required free space or inodes'
require_capacity "$BACKUP_ROOT" "$REQUIRED_BACKUP_BYTES" "$MIN_FREE_INODES" \
    || fail 'backup filesystem lacks required free space or inodes'
require_capacity \
    "$VALIDATION_TMP_ROOT" "$MIN_VALIDATION_TMP_BYTES" "$MIN_VALIDATION_TMP_INODES" \
    || fail 'validation temp filesystem lacks required free space or inodes'

owner_git -C "$PRIMARY" fetch --prune origin main
REMOTE_MAIN="$(owner_git -C "$PRIMARY" rev-parse refs/remotes/origin/main)"
owner_git -C "$PRIMARY" cat-file -e "${TARGET_SHA}^{commit}"
[[ "$TARGET_SHA" == "$REMOTE_MAIN" ]] \
    || fail 'target SHA is not current origin/main'

if [[ -s "$STATE_FILE" ]]; then
    OLD_SHA="$(tr -d '[:space:]' <"$STATE_FILE")"
fi

if [[ "$OLD_SHA" == "$TARGET_SHA" ]]; then
    write_summary 'NO_OP_ALREADY_CURRENT' false
    exit 0
fi

if [[ "$OLD_SHA" =~ ^[0-9a-f]{40}$ ]] \
   && owner_git -C "$PRIMARY" merge-base --is-ancestor "$TARGET_SHA" "$OLD_SHA"; then
    write_summary 'NO_OP_STALE' false
    exit 0
fi

install -d -o "$OWNER" -g "$OWNER" -m 0700 \
    /home/andris/.cache/rozkalns-cv-deploy
WORK="$(runuser -u "$OWNER" -- \
    mktemp -d '/home/andris/.cache/rozkalns-cv-deploy/run.XXXXXXXX')"
STAGE="$WORK/source"
CANDIDATE="$WORK/candidate"
owner_git -C "$PRIMARY" worktree add --detach "$STAGE" "$TARGET_SHA" >/dev/null

runuser -u "$OWNER" -- bash -c \
    'export TMPDIR="$1"; cd "$2" && exec bash "$2/scripts/validate-source.sh" "$2"' \
    bash "$VALIDATION_TMP_ROOT" "$STAGE" \
    >"$EVIDENCE_DIR/source-validation.log" 2>&1 \
    || fail 'source validation failed'
prepare_candidate || fail 'candidate preparation failed'

if ! validate_candidate_runtime_prerequisites \
    >"$EVIDENCE_DIR/target-prerequisites.log" 2>&1; then
    fail 'target runtime prerequisites failed before production mutation'
fi

BACKUP="$BACKUP_ROOT/${STAMP}-${OLD_SHA:-unknown}"
create_backup || fail 'rollback backup creation failed'
capture_runtime_diagnostics 'pre-deploy-runtime'

MUTATION_STARTED=true
DEPLOYED=true
if ! managed_rsync "$CANDIDATE" "$RUNTIME" \
    >"$EVIDENCE_DIR/deploy.log" 2>&1; then
    capture_runtime_diagnostics 'failed-source-sync-runtime'
    fail 'production source synchronization failed'
fi

if ! deploy_runtime >>"$EVIDENCE_DIR/deploy.log" 2>&1; then
    capture_runtime_diagnostics 'failed-deploy-runtime'
    fail 'runtime deployment checks failed'
fi

if ! verify_public_frontend_contracts >>"$EVIDENCE_DIR/deploy.log" 2>&1; then
    capture_runtime_diagnostics 'failed-public-contract-runtime'
    fail 'public frontend contract verification failed'
fi

capture_runtime_diagnostics 'post-deploy-runtime'
write_runtime_manifest "$EVIDENCE_DIR/runtime-managed.sha256" \
    || fail 'runtime manifest generation failed'
write_state_atomically || fail 'atomic deployed-state update failed'
TRANSACTION_COMMITTED=true
prune_backups || printf 'WARNING: post-deploy backup pruning failed\n' \
    | tee -a "$EVIDENCE_DIR/deploy.log" >&2
write_summary 'PASS' false
