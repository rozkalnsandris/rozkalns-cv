{
  "schema": "rozkalns.agent-bootstrap.v1",
  "repository": "rozkalnsandris/rozkalns-cv",
  "shared_policy": {
    "work_cycle": "docs/WORK_CYCLE_V23_ADOPTION.md",
    "github_api_access": ".github/github-api-access-v1.json"
  },
  "rules": {
    "primary": "AGENTS.md",
    "local_strict_rules": [
      "AGENTS.md#security-and-deployment",
      "AGENTS.md#repository-local-source-only-full-mode"
    ]
  },
  "continuation": {
    "kind": "none"
  },
  "automation": {
    "fast_lane": true,
    "auto_run_full": true,
    "queue_mode": "supported"
  },
  "deployment_profile": "simple-deploy"
}
