[Unit]
Description=Refresh rozkalns.net live homelab statistics
Documentation=https://github.com/rozkalnsandris/rozkalns-cv
Wants=network-online.target
After=network-online.target docker.service
ConditionPathIsExecutable=/home/andris/docker/cv/stats.sh

[Service]
Type=oneshot
User=andris
Group=andris
SupplementaryGroups=docker
WorkingDirectory=/home/andris/docker/cv
RuntimeDirectory=rozkalns-cv-stats
RuntimeDirectoryMode=0750
ExecStart=/home/andris/docker/cv/stats.sh --lock /run/rozkalns-cv-stats/generator.lock
TimeoutStartSec=45s
UMask=0022

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/andris/docker/cv/html /run/rozkalns-cv-stats
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
