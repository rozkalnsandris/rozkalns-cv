{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rozkalns.net/schemas/profile.schema.json",
  "title": "Canonical public CV profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "identity",
    "contact",
    "languages",
    "experience",
    "education",
    "skills",
    "projects",
    "infrastructure"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "content_version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "location", "availability", "career_goal"],
      "properties": {
        "name": {"type": "string", "minLength": 2},
        "role": {"type": "string", "minLength": 2},
        "location": {"type": "string", "minLength": 2},
        "availability": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "career_goal": {"type": "string", "minLength": 10}
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "phone", "github", "website"],
      "properties": {
        "email": {"$ref": "#/$defs/verifiedRuntimeContact"},
        "phone": {"$ref": "#/$defs/verifiedRuntimeContact"},
        "github": {"$ref": "#/$defs/publicValue"},
        "website": {"$ref": "#/$defs/publicValue"}
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "level": {"type": "string", "minLength": 1}
        }
      }
    },
    "experience": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/experience"}},
    "education": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/education"}},
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "working", "learning", "foundations"],
      "properties": {
        "core": {"$ref": "#/$defs/nonEmptyStrings"},
        "working": {"$ref": "#/$defs/nonEmptyStrings"},
        "learning": {"$ref": "#/$defs/nonEmptyStrings"},
        "foundations": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "projects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/project"}},
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "storage", "runtime", "availability", "public_site"],
      "properties": {
        "host": {"type": "string", "minLength": 2},
        "storage": {"type": "string", "minLength": 2},
        "runtime": {"type": "string", "minLength": 2},
        "availability": {"type": "string", "minLength": 2},
        "public_site": {"type": "string", "format": "uri"}
      }
    }
  },
  "$defs": {
    "verifiedRuntimeContact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility"],
      "properties": {
        "visibility": {"const": "verified-runtime"}
      }
    },
    "publicValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "visibility"],
      "properties": {
        "value": {"type": "string", "minLength": 2},
        "visibility": {"const": "public"}
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "organization", "location", "start", "end", "highlights"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "role": {"type": "string", "minLength": 2},
        "organization": {"type": "string", "minLength": 2},
        "location": {"type": "string", "minLength": 2},
        "start": {"type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2})?$"},
        "end": {"type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2})?$"},
        "end_planned": {"type": "boolean"},
        "highlights": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 2},
        "organization": {"type": "string", "minLength": 2},
        "start": {"type": "string", "pattern": "^[0-9]{4}$"},
        "end": {"type": "string", "pattern": "^[0-9]{4}$"},
        "status": {"type": "string", "minLength": 2},
        "detail": {"type": "string", "minLength": 2}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "facts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 2},
        "facts": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    }
  }
}
