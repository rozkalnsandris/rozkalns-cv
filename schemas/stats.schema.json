{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rozkalns.net/schemas/stats.schema.json",
  "title": "rozkalns.net live homelab statistics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updated",
    "uptime_30d",
    "services",
    "docker_containers",
    "docker_images",
    "cpu_temp",
    "days_online",
    "cpu_usage",
    "ram_usage",
    "disk_usage",
    "load1",
    "net_down",
    "net_up"
  ],
  "properties": {
    "updated": {"type": "string", "format": "date-time"},
    "uptime_30d": {"type": ["number", "null"]},
    "services": {"type": ["integer", "null"], "minimum": 0},
    "docker_containers": {"type": "integer", "minimum": 0},
    "docker_images": {"type": "integer", "minimum": 0},
    "cpu_temp": {"type": ["number", "null"]},
    "days_online": {"type": ["integer", "null"], "minimum": 0},
    "cpu_usage": {"type": ["number", "null"]},
    "ram_usage": {"type": ["number", "null"]},
    "disk_usage": {"type": ["number", "null"]},
    "load1": {"type": ["number", "null"]},
    "net_down": {"type": ["number", "null"]},
    "net_up": {"type": ["number", "null"]}
  }
}
